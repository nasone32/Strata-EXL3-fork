{
  "4.05-cpu-ram-repack": {
    "cwd": "${CHECKOUT}",
    "env": {
      "HIP_VISIBLE_DEVICES": "0",
      "STRATA_AUX_CPUS": "off",
      "STRATA_EXL3_CPU_TIER": "1",
      "STRATA_EXL3_PEER_ADAPT": "0",
      "STRATA_EXL3_RESIDENT": "all",
      "STRATA_QWEN_BAND8": "memory",
      "STRATA_EXL3_CPU_THREADS": "8",
      "STRATA_EXL3_CPU_HYBRID": "2",
      "STRATA_EXL3_CPU_HYBRID_MIN_MISSES": "1",
      "STRATA_EXL3_CPU_CACHE_MIB": "0",
      "STRATA_EXL3_CPU_SWIZZLE": "0"
    },
    "args": [
      "--exl3",
      "${MODEL_4}",
      "--ple-exl3",
      "${MODEL_4}/ngram_embedding.safetensors",
      "--expert-profile",
      "${CHECKOUT}/data/expert-profile.bin",
      "--expert-cache",
      "104",
      "--expert-ram-cache",
      "0",
      "--vram-reserve-mib",
      "2048",
      "--peer-reserve-mib",
      "4096",
      "--prefill",
      "8192",
      "--max-context",
      "65536",
      "--kv",
      "int8",
      "--mtp",
      "${MTP}",
      "--spec",
      "4",
      "--spec-min-p",
      "0.5",
      "--ple-io",
      "direct",
      "--prompt-cache",
      "0",
      "--conversation-cache-slots",
      "0",
      "--prompt-cache-every",
      "0"
    ],
    "lib_dirs": [],
    "tokenizer": "${TOKENIZER}"
  },
  "4.05-native-gpu-only": {
    "cwd": "${CHECKOUT}",
    "env": {
      "HIP_VISIBLE_DEVICES": "0",
      "STRATA_AUX_CPUS": "off",
      "STRATA_EXL3_CPU_TIER": "0",
      "STRATA_EXL3_PEER_ADAPT": "0",
      "STRATA_EXL3_RESIDENT": "all"
    },
    "args": [
      "--exl3",
      "${MODEL_4}",
      "--ple-exl3",
      "${MODEL_4}/ngram_embedding.safetensors",
      "--expert-profile",
      "${CHECKOUT}/data/expert-profile.bin",
      "--expert-cache",
      "104",
      "--expert-ram-cache",
      "0",
      "--vram-reserve-mib",
      "2048",
      "--peer-reserve-mib",
      "4096",
      "--prefill",
      "8192",
      "--max-context",
      "65536",
      "--kv",
      "int8",
      "--mtp",
      "${MTP}",
      "--spec",
      "4",
      "--spec-min-p",
      "0.5",
      "--ple-io",
      "direct",
      "--prompt-cache",
      "0",
      "--conversation-cache-slots",
      "0",
      "--prompt-cache-every",
      "0"
    ],
    "lib_dirs": [],
    "tokenizer": "${TOKENIZER}"
  }
}
